 PORT Intr = ext_mb0_irq1 & xps_uartlite_1_Interrupt & xps_uartlite_2_Interrupt & mipsy_iomodule_GPI1_Interrupt & mipsy_iomodule_PIT1_Interrupt & mipsy_iomodule_PIT2_Interrupt & mipsy_iomodule_PIT3_Interrupt & mipsy_iomodule_FIT3_Interrupt & ext_mb0_irq0 & mb_plb_Bus_Error_Det & mdm_0_Interrupt
 PORT Irq = xps_intc_0_Irq
END


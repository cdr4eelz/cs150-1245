
# EJR: Adjusted to  xc5vlx110t  rather than  xc5vlx50t
# EJR: Hand/GUI edited (XPS)
# Constants allowed at global level (except as signals): Watch for these markers
# FREQ_REF   100000000
# FREQ_MIPSY 50000000
# FREQ_PLOP  125000000
# FREQ_BRK   50000000
# FREQ_DVI   75000000
# ##############################################################################
# BASED on Base System Builder Wizard for Xilinx EDK 14.6 Build EDK_P.68d
# Target Board:  Xilinx Virtex 5 ML505 Evaluation Platform (CS150-CORY125)
# Family:    virtex5
# Device:    xc5vlx110t
# Package:   ff1136
# Speed Grade:  -1
# Processor number: 1
# Processor 1: microblaze_0
# System clock frequency: 125.0
# Debug Interface: On-Chip HW Debug Module
# ##############################################################################
 PARAMETER VERSION = 2.1.0


# FREQ_MIPSY
 PORT CLK_MIPSY = net_clk_mipsy, DIR = I, SIGIS = CLK, CLK_FREQ = 50000000
# FREQ_PLOP
 PORT CLK_PLOP = net_clk_0, DIR = I, SIGIS = CLK, CLK_FREQ = 125000000
 PORT CLK_Locked = net_clk_locked, DIR = I
 PORT RST_PHY_LO = net_rst_phy_s, DIR = I, SIGIS = RST, RST_POLARITY = 0
 PORT RST_AUX_HI = net_rst_aux, DIR = I, SIGIS = RST, RST_POLARITY = 1
 PORT RST_Periph_HI = net_rst_periph, DIR = O, SIGIS = RST, RST_POLARITY = 1
 PORT MB0_IRQ0 = ext_mb0_irq0, DIR = I, SIGIS = INTERRUPT, SENSITIVITY = EDGE_RISING
 PORT MB0_IRQ1 = ext_mb0_irq1, DIR = I, SIGIS = INTERRUPT, SENSITIVITY = EDGE_RISING
 PORT MB0_Error = microblaze_0_error, DIR = O
 PORT MB0_Halted = microblaze_0_halted, DIR = O
# ## MIPSY BIOS backdoor ##
 PORT BIOS_BRAM_Rst = bram_bios_Rst_A, DIR = O, SIGIS = RST, RST_POLARITY = 1
# FREQ_PLOP
 PORT BIOS_BRAM_Clk = bram_bios_Clk_A, DIR = O, SIGIS = CLK, CLK_FREQ = 125000000
 PORT BIOS_BRAM_En = bram_bios_EN_A, DIR = O
 PORT BIOS_BRAM_Wen = bram_bios_WEN_A, DIR = O, VEC = [0:3]
 PORT BIOS_BRAM_Addr = bram_bios_Addr_A, DIR = O, VEC = [0:31]
 PORT BIOS_BRAM_Dout = bram_bios_Dout_A, DIR = O, VEC = [0:31]
 PORT BIOS_BRAM_DIN = bram_bios_Din_A, DIR = I, VEC = [0:31]
# ## BRK control/traces via shared memory ##
 PORT BRK_BRAM_RST = bram_brk_BRAM_Rst_B, DIR = I, SIGIS = RST, RST_POLARITY = 1
# FREQ_BRK
 PORT BRK_BRAM_CLK = bram_brk_BRAM_Clk_B, DIR = I, SIGIS = CLK, CLK_FREQ = 50000000
 PORT BRK_BRAM_EN = bram_brk_BRAM_EN_B, DIR = I
 PORT BRK_BRAM_WEN = bram_brk_BRAM_WEN_B, DIR = I, VEC = [0:3]
 PORT BRK_BRAM_ADDR = bram_brk_BRAM_Addr_B, DIR = I, VEC = [0:31]
 PORT BRK_BRAM_DOUT = bram_brk_BRAM_Dout_B, DIR = I, VEC = [0:31]
 PORT BRK_BRAM_Din = bram_brk_BRAM_Din_B, DIR = O, VEC = [0:31]
# ## BRK registers via DCR ##
 PORT BRK_DCR_Rst = mipsy_dcr_PLB_dcrRst, DIR = O, SIGIS = RST, RST_POLARITY = 1
# FREQ_PLOP
 PORT BRK_DCR_Clk = mipsy_dcr_PLB_dcrClk, DIR = O, SIGIS = CLK, CLK_FREQ = 125000000
 PORT BRK_DCR_Read = mipsy_dcr_PLB_dcrRead, DIR = O
 PORT BRK_DCR_Write = mipsy_dcr_PLB_dcrWrite, DIR = O
 PORT BRK_DCR_ABus = mipsy_dcr_PLB_dcrABus, DIR = O, VEC = [0:9]
 PORT BRK_DCR_DWBus = mipsy_dcr_PLB_dcrDBusOut, DIR = O, VEC = [0:31]
 PORT BRK_DCR_DRBUS = mipsy_dcr_DCR_plbDBusIn, DIR = I, VEC = [0:31]
 PORT BRK_DCR_ACK = mipsy_dcr_DCR_plbAck, DIR = I
# ## GPIO ##
 PORT GPI1_32 = iomodule_0_GPI1, DIR = I, VEC = [31:0]
 PORT GPI2_32 = iomodule_0_GPI2, DIR = I, VEC = [31:0]
 PORT GPI3_32 = iomodule_0_GPI3, DIR = I, VEC = [31:0]
 PORT GPI4_32 = iomodule_0_GPI4, DIR = I, VEC = [31:0]
 PORT GPo1_32 = iomodule_0_GPO1, DIR = O, VEC = [31:0]
 PORT GPo2_32 = iomodule_0_GPO2, DIR = O, VEC = [31:0]
 PORT GPo3_32 = iomodule_0_GPO3, DIR = O, VEC = [31:0]
 PORT GPo4_32 = iomodule_0_GPO4, DIR = O, VEC = [31:0]
# ## UARTs ##
 PORT UART_PHY_RX = Uart_1_RX, DIR = I
 PORT UART_PHY_Tx = Uart_1_TX, DIR = O
 PORT UART_MIPSY_RX = Uart_2_RX, DIR = I
 PORT UART_MIPSY_Tx = Uart_2_TX, DIR = O


BEGIN microblaze
 PARAMETER INSTANCE = microblaze_0
 PARAMETER C_USE_BARREL = 1
 PARAMETER C_DEBUG_ENABLED = 1
 PARAMETER HW_VER = 8.50.b
 PARAMETER C_NUMBER_OF_PC_BRK = 2
 PARAMETER C_NUMBER_OF_WR_ADDR_BRK = 0
 PARAMETER C_NUMBER_OF_RD_ADDR_BRK = 0
 PARAMETER C_USE_ICACHE = 0
 PARAMETER C_CACHE_BYTE_SIZE = 8192
 PARAMETER C_ICACHE_ALWAYS_USED = 1
 PARAMETER C_ICACHE_FORCE_TAG_LUTRAM = 0
 PARAMETER C_USE_DCACHE = 0
 PARAMETER C_DCACHE_BYTE_SIZE = 8192
 PARAMETER C_DCACHE_ALWAYS_USED = 1
 PARAMETER C_DCACHE_FORCE_TAG_LUTRAM = 0
 PARAMETER C_ICACHE_BASEADDR = 0x10000000
 PARAMETER C_ICACHE_HIGHADDR = 0x1FFFFFFF
 PARAMETER C_ICACHE_STREAMS = 0
 PARAMETER C_ICACHE_VICTIMS = 0
 PARAMETER C_DCACHE_BASEADDR = 0x20000000
 PARAMETER C_DCACHE_HIGHADDR = 0x2FFFFFFF
 PARAMETER C_DCACHE_USE_WRITEBACK = 0
 PARAMETER C_USE_BRANCH_TARGET_CACHE = 1
 PARAMETER C_FSL_LINKS = 2
 PARAMETER C_USE_HW_MUL = 1
 PARAMETER C_USE_DIV = 1
 PARAMETER C_USE_EXTENDED_FSL_INSTR = 1
 PARAMETER C_BRANCH_TARGET_CACHE_SIZE = 0
 PARAMETER C_DIV_ZERO_EXCEPTION = 1
 PARAMETER C_IPLB_BUS_EXCEPTION = 0
 PARAMETER C_DPLB_BUS_EXCEPTION = 0
 PARAMETER C_ILL_OPCODE_EXCEPTION = 1
 PARAMETER C_OPCODE_0x0_ILLEGAL = 0
 PARAMETER C_UNALIGNED_EXCEPTIONS = 1
 PARAMETER C_PVR = 0
 PARAMETER C_USE_MMU = 0
 PARAMETER C_ICACHE_LINE_LEN = 8
 PARAMETER C_USE_FPU = 1
 BUS_INTERFACE DPLB = mb_plb
 BUS_INTERFACE IPLB = mb_plb
 BUS_INTERFACE DEBUG = microblaze_0_mdm_bus
 BUS_INTERFACE DLMB = dlmb
 BUS_INTERFACE ILMB = ilmb
 BUS_INTERFACE INTERRUPT = mipsy_iomodule_INTERRUPT
 PORT MB_Error = microblaze_0_error
 PORT MB_Halted = microblaze_0_halted
 PORT MB_RESET = sys_rst_mb
END


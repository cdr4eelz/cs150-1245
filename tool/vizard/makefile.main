vizard: $(APP_ISR_BIN) $(VIZARD_SRCS) $(VIZARD_HDRS) $(VIZARD_GPU_SRC) $(APP_COMMON_DIR)/ascii.c $(VIZARD_GRAPHICS_SRC) $(APP_UART_SRC) $(VIZARD_UART_SRC) $(APP_COMMON_HEADERS) $(APP_OBJ) $(APP_SHARED_OBJ) $(VIZARD_GRAPHICS_OBJ) | isr-warn
	@if ! pkg-config --exists raylib; then \
		echo "Raylib is required to build the graphical app (pkg-config package: raylib)." >&2; \
		exit 1; \
	fi
	$(CC) $(CPPFLAGS) $(CFLAGS) $(VIZARD_SHARED_CPPFLAGS) -Isrc -DVIZARD -DVIZARD_ISR_IMAGE='"$(abspath $(APP_ISR_BIN))"' $(RAYLIB_CFLAGS) $(VIZARD_SRCS) $(VIZARD_GPU_SRC) $(APP_COMMON_DIR)/ascii.c $(VIZARD_GRAPHICS_SRC) $(APP_UART_SRC) $(VIZARD_UART_SRC) $(APP_OBJ) $(APP_SHARED_OBJ) -o $@ $(RAYLIB_LIBS) -lm

$(APP_ISR_BIN):
	@echo "error: $@ file missing; build it in $(APP_SRC_DIR) first" >&2; exit 1

isr-warn:
	@if [ -n "$$(find $(APP_ISR_SRC) -newer $(APP_ISR_BIN) 2>/dev/null)" ]; then \
		echo "warning: $(APP_ISR_BIN) is older than its sources ($(APP_ISR_SRC)); rebuild it in $(APP_SRC_DIR)" >&2; \
	fi

$(APP_OBJ): $(APP_SRC) $(VIZARD_HDRS) $(APP_COMMON_HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD -Dmain=vizard_app_main -c $< -o $@

$(APP_SHARED_OBJ): $(APP_SHARED_SRC) $(APP_SHARED_HEADER) $(VIZARD_HDRS) $(APP_COMMON_HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD -c $< -o $@

$(VIZARD_GRAPHICS_OBJ): $(VIZARD_GRAPHICS_SRC) $(APP_COMMON_DIR)/graphics.h $(VIZARD_HDRS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD -c $< -o $@

clean-main:
	rm -f vizard $(APP_OBJ) $(APP_SHARED_OBJ) $(VIZARD_GRAPHICS_OBJ)

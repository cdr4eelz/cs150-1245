check: tests/test_core tests/test_graphics_bridge tests/test_frame_extra_overflow tests/test_mips
	./tests/test_core
	./tests/test_mips
	./tests/test_graphics_bridge
	@output=$$(ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 ./tests/test_frame_extra_overflow 2>&1); status=$$?; \
	if test $$status -eq 0 || ! printf '%s\n' "$$output" | grep -q 'AddressSanitizer: global-buffer-overflow'; then \
		printf '%s\n' "$$output"; \
		echo "Expected ASan global-buffer-overflow was not detected." >&2; \
		exit 1; \
	fi; \
	printf '%s\n' "$$output" | grep -m1 'AddressSanitizer: global-buffer-overflow'; \
	echo "FRAME_EXTRA_TAIL overflow caught by ASan as expected."

tests/test_core: tests/test_core.c $(VIZARD_GPU_SRC) $(APP_UART_SRC) $(VIZARD_UART_SRC) $(APP_COMMON_HEADERS) $(VIZARD_HDRS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD tests/test_core.c $(VIZARD_GPU_SRC) $(APP_UART_SRC) $(VIZARD_UART_SRC) -o $@ -lm

tests/test_mips: tests/test_mips.c src/vizard_mips.c src/vizard_mips.h $(APP_SHARED_HEADER) $(APP_ISR_BIN) | isr-warn
	$(CC) $(CPPFLAGS) $(CFLAGS) $(VIZARD_SHARED_CPPFLAGS) -Isrc -DVIZARD_ISR_IMAGE='"$(abspath $(APP_ISR_BIN))"' tests/test_mips.c src/vizard_mips.c -o $@

tests/test_graphics_bridge: tests/test_graphics_bridge.c $(VIZARD_GRAPHICS_OBJ) $(APP_COMMON_DIR)/graphics.h $(VIZARD_HDRS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD $< $(VIZARD_GRAPHICS_OBJ) -o $@

tests/test_frame_extra_overflow: tests/test_frame_extra_overflow.c $(VIZARD_GRAPHICS_OBJ) $(APP_COMMON_DIR)/graphics.h $(VIZARD_HDRS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -iquote $(APP_COMMON_DIR) -Isrc -DVIZARD $< $(VIZARD_GRAPHICS_OBJ) -o $@

clean-tests:
	rm -f tests/test_core tests/test_graphics_bridge tests/test_frame_extra_overflow tests/test_mips

################################################################################
# GPIO
################################################################################

# DIP-SWITCHES (BOTTOM-RIGHT) (SW#{1:8}==GPIO_DIP_SW{1:8}==GPIO_DIP[0:7], respectively)
#    (Bus/Rename of GPIO_DIP_SW1, GPIO_DIP_SW2, ...GPIO_DIP_SW8)
# Bank 15, Vcco=1.8V, DCI 49.9ohm
NET "GPIO_DIP[*]"       IOSTANDARD="LVCMOS18" | SLEW="SLOW" | DRIVE="2" | PULLDOWN;
NET  "GPIO_DIP[0]"        LOC="U25";
NET  "GPIO_DIP[1]"        LOC="AG27";
NET  "GPIO_DIP[2]"        LOC="AF25";
NET  "GPIO_DIP[3]"        LOC="AF26";
NET  "GPIO_DIP[4]"        LOC="AE27";
NET  "GPIO_DIP[5]"        LOC="AE26";
NET  "GPIO_DIP[6]"        LOC="AC25";
NET  "GPIO_DIP[7]"        LOC="AC24";
NET "GPIO_DIP[*]" TIG;

# PUSH-BUTTONS "COMPASS" (BOTTOM-RIGHT) (SW{14:10}==GPIO_SW_{CWESN}==GPIO_COMPPB[4:0], respectively)
#    (Bus/Rename of GPIO_SW_C, GPIO_SW_W, GPIO_SW_E, GPIO_SW_S, GPIO_SW_N)
# Bank 18, Vcco=3.3V, No DCI
NET "GPIO_COMPPB[*]"    IOSTANDARD="LVCMOS33" | SLEW="SLOW" | DRIVE="2" | PULLDOWN;
NET  "GPIO_COMPPB[4]"     LOC="AJ6";
NET  "GPIO_COMPPB[3]"     LOC="AJ7";
NET  "GPIO_COMPPB[2]"     LOC="AK7";
NET  "GPIO_COMPPB[1]"     LOC="V8";
NET  "GPIO_COMPPB[0]"     LOC="U8";
NET "GPIO_COMPPB[*]" TIG;

# ROTARY-SWITCH (BOTTOM-RIGHT)
# Bank 17, Vcco=1.8V,  DCI 49.9ohm
NET "FPGA_ROTARY_*"     SLEW="SLOW" | DRIVE="2" | PULLDOWN;
NET  "FPGA_ROTARY_INCA"   LOC="AH30"  |  IOSTANDARD="LVCMOS18";
NET  "FPGA_ROTARY_INCB"   LOC="AG30"  |  IOSTANDARD="LVCMOS18";
NET  "FPGA_ROTARY_PUSH"   LOC="AH29"  |  IOSTANDARD="LVCMOS18";
NET "FPGA_ROTARY_INCA" TIG;
NET "FPGA_ROTARY_INCB" TIG;
NET "FPGA_ROTARY_PUSH" TIG;

# LEDs "GPIO" green (BOTTOM-CENTER w/GAP)
#    (Bus/Rename of GPIO_LED_0, GPIO_LED_1, ...GPIO_LED_7)
NET "GPIO_LED[*]"       SLEW="SLOW" | DRIVE="2"; # | PULLDOWN;
NET  "GPIO_LED[0]"        LOC="H18"   |  IOSTANDARD="LVCMOS25"; # Bank  3, Vcco=2.5V, No DCI
NET  "GPIO_LED[1]"        LOC="L18"   |  IOSTANDARD="LVCMOS25"; # Bank  3, Vcco=2.5V, No DCI
NET  "GPIO_LED[2]"        LOC="G15"   |  IOSTANDARD="LVCMOS25"; # Bank  3, Vcco=2.5V, No DCI
NET  "GPIO_LED[3]"        LOC="AD26"  |  IOSTANDARD="LVCMOS18"; # Bank 21, Vcco=1.8V, DCI 49.9ohm
NET  "GPIO_LED[4]"        LOC="G16"   |  IOSTANDARD="LVCMOS25"; # Bank  3, Vcco=2.5V, No DCI
NET  "GPIO_LED[5]"        LOC="AD25"  |  IOSTANDARD="LVCMOS18"; # Bank 21, Vcco=1.8V, DCI 49.9ohm
NET  "GPIO_LED[6]"        LOC="AD24"  |  IOSTANDARD="LVCMOS18"; # Bank 21, Vcco=1.8V, DCI 49.9ohm
NET  "GPIO_LED[7]"        LOC="AE24"  |  IOSTANDARD="LVCMOS18"; # Bank 21, Vcco=1.8V, DCI 49.9ohm
NET "GPIO_LED[*]" TIG;

# LEDs "COMPASS" green (BOTTOM-RIGHT) (DS{24/3/1/2/0}==GPIO_LED_{CWESN}==GPIO_COMPLED_[4:0], respectively)
#    (Bus/Rename of GPIO_LED_C, GPIO_LED_W, GPIO_LED_E, GPIO_LED_S, GPIO_LED_N)
NET "GPIO_COMPLED[*]"   SLEW="SLOW" | DRIVE="2"; # | PULLDOWN;
NET  "GPIO_COMPLED[4]"    LOC="E8"    |  IOSTANDARD="LVCMOS33"; # Bank 20, Vcco=3.3V, DCI 49.9ohm
NET  "GPIO_COMPLED[3]"    LOC="AF23"  |  IOSTANDARD="LVCMOS33"; # Bank  2, Vcco=3.3V
NET  "GPIO_COMPLED[2]"    LOC="AG23"  |  IOSTANDARD="LVCMOS33"; # Bank  2, Vcco=3.3V
NET  "GPIO_COMPLED[1]"    LOC="AG12"  |  IOSTANDARD="LVCMOS33"; # Bank  2, Vcco=3.3V
NET  "GPIO_COMPLED[0]"    LOC="AF13"  |  IOSTANDARD="LVCMOS33"; # Bank  2, Vcco=3.3V
NET "GPIO_COMPLED[*]" TIG;

# LEDs "ERRORS" red (BOTTOM-CENTER left of GPIO-LEDs) (ERR{2|1}==BUS_ERROR_{2|1}, respectively)
# Bank 12, Vcco=3.3V,  DCI 49.9ohm  #NOTE: WHY 1.8V, not that LEDs care???
NET  "BUS_ERROR_1"        LOC="F6"    |  IOSTANDARD="LVCMOS18" | SLEW="SLOW" | DRIVE="2";
NET  "BUS_ERROR_2"        LOC="T10"   |  IOSTANDARD="LVCMOS18" | SLEW="SLOW" | DRIVE="2";
NET  "BUS_ERROR_1" TIG;
NET  "BUS_ERROR_2" TIG;


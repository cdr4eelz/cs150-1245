## A variable differential clock source can be connected to J10 and J11. If no
## other clock source is available, the DDR2 clock can be generated by the ML50x
## Diff Clk Out, J12 and J13.
## Bank 3, Vcco=2.5V, No DCI
#ON ML505-lx50 NET  SMA_DIFF_CLK_IN_N    LOC="H15"   |  IOSTANDARD="LVDS_25" | DIFF_TERM="TRUE";
#ON ML505-lx50 NET  SMA_DIFF_CLK_IN_P    LOC="H14"   |  IOSTANDARD="LVDS_25" | DIFF_TERM="TRUE";
## SW6 Setting: ug347.pdf (J54 must be connected for the Diff Clk Out to operate)
##             12345678
## 150 MHz:    11001010
## 200 MHz:    01001010
## 300 MHz:    10001010

# Bank 20, Vcco=3.3V, DCI 49.9 ohm
NET  "FPGA_CPU_RESET_B"   LOC="E9"    |  IOSTANDARD="LVCMOS33"  |  PULLUP; #Some use LVCMOS18
NET "FPGA_CPU_RESET_B" TIG;


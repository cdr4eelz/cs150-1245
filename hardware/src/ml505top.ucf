#NOTE: RE-MERGED with XUP5.ucf and MIG from partgen output known to be clean/running.
#NOTE: Layout style and extra goodies like DRIVE, SLEW, PULLDOWN brought in from other examples.
#NOTE: DDR2 run speed set like -53E but rated -667 (for example CAS=3 for slower rate vs. 4).
#NOTE: Dilligently pulled Bank/Vcco/DCI info from XUPv5 master UCF w/consistent format.
#NOTE: TIGs added on appropriate lines like GPIO or other known ASYNC inputs.


################################################################################
# PROJECT SPECIFIC SPECIAL DATAPATHs/TIGs
################################################################################

#TODO: Apply ultra-consistent naming on cross-clock NET/INST & use wildcards (cautiously)

# Avoid false path on cross-clock synchronizers & resets (but impose an arbitrary max)
NET  "cpu_clk_g" TNM = "TN_SYNC_FROM_CPU";
INST "*/pixelfeed/*_clkDVI" TNM = "TN_SYNC_TO_DVI";
TIMESPEC "TS_CPU_SYNC_DVI" = FROM "TN_SYNC_FROM_CPU" TO "TN_SYNC_TO_DVI" 10 ns DATAPATHONLY;

NET  "dvi_clk_g" TNM = "TN_SYNC_FROM_DVI";
INST "*/pixelfeed/*_clkCPU" TNM = "TN_SYNC_TO_CPU";
TIMESPEC "TS_DVI_SYNC_CPU" = FROM "TN_SYNC_FROM_DVI" TO "TN_SYNC_TO_CPU" 10 ns DATAPATHONLY;

INST "*_clkCPU*" TNM = "TN_TO_RST_CPU";
TIMESPEC "TS_RST_SYNC_CPU" = TO "TN_TO_RST_CPU" 10 ns DATAPATHONLY;
INST "*_clkDVI*" TNM = "TN_TO_RST_DVI";
TIMESPEC "TS_RST_SYNC_DVI" = TO "TN_TO_RST_DVI" 10 ns DATAPATHONLY;
#NET "reset_advance[0]" TIG;



################################################################################
# BOARD CLOCKs & RESET

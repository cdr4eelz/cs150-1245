# Bank  4, Vcco=3.3V, No DCI
NET  "USER_CLK"           LOC="AH15"  |  IOSTANDARD="LVCMOS33";
NET  "USER_CLK"           TNM_NET="TN_CLK_100MHZ";
TIMESPEC TS_100MHZ = PERIOD "TN_CLK_100MHZ" 10.0 ns;# HIGH 50 %;

# Bank  3, Vcco=2.5V, No DCI
#NET  "CLK_FPGA_N"         LOC="K19"   |  IOSTANDARD="LVDS_25" | DIFF_TERM="TRUE";
#NET  "CLK_FPGA_P"         LOC="L19"   |  IOSTANDARD="LVDS_25" | DIFF_TERM="TRUE";

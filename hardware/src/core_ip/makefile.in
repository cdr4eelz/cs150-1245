XCO_SRC = $(wildcard *.xco)
V_SRC := $(patsubst %.xco,%.v,$(XCO_SRC))
CG_FLAGS ?= -intstyle silent

all: $(V_SRC)

%.v: %.xco coregen.cgp
	coregen $(CG_FLAGS) -p coregen.cgp -b $*.xco
	-rm -rf $*/* $*.xci $*_*.tcl $*_*.txt $*.gise *.cgc *.log tmp xlnx*
	-rmdir $*

clean:
	find . ! -name '*.xco' -a ! -name 'Makefile' -a ! -name '*.coe' -a ! -name '*.cgp' -a ! -name '.gitignore' -a ! -name 'stash*' -a ! -type l -delete


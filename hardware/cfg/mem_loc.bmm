ADDRESS_MAP MIPSY PPC405 0

// Note the slight difference in paths between the lanes:
// CPU/bram_dmem vs. CPU/bram_imem
// SP.SINGLE_PRIM36.SP vs. SDP.SINGLE_PRIM36.TDP
//  The _xmsgs/xst.xmsgs created by coregen seems a viable place to get the tail of these paths (besides examiniation in fpga_editor or planAhead).

// RAMB36 is blockram with parity (32-bits data + 4-bits parity, one-per-byte)
// In each BRAM, each lane is 4K (5120 w/parity) for total 16K (20480 w/parity)

/* *** CONSOLIDATED MEMORY SPAN makes it easier to use the tools to punch it *** */
    ADDRESS_SPACE BRAM_BOTH COMBINED WORD_ADDRESSING [0x00000000:0x00007FFF]

    ADDRESS_RANGE RAMB36
//  ADDRESS_SPACE BRAM_DATA RAMB36 WORD_ADDRESSING [0x10000000:0x10003FFF]
        BUS_BLOCK
            CPU/bram_dmem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[3].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [35:27] OUTPUT = DMEM3.mem LOC = X1Y7;
            CPU/bram_dmem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[2].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [26:18] OUTPUT = DMEM2.mem LOC = X1Y4;
            CPU/bram_dmem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[1].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [17:9]  OUTPUT = DMEM1.mem LOC = X1Y5;
            CPU/bram_dmem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[0].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [8:0]   OUTPUT = DMEM0.mem LOC = X1Y6;
        END_BUS_BLOCK;
//  END_ADDRESS_SPACE;
    END_ADDRESS_RANGE;

    ADDRESS_RANGE RAMB36
//  ADDRESS_SPACE BRAM_INST RAMB36 WORD_ADDRESSING [0x20000000:0x20003FFF]
        BUS_BLOCK
            CPU/bram_imem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[3].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [35:27] OUTPUT = IMEM3.mem LOC = X2Y3;
            CPU/bram_imem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[2].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [26:18] OUTPUT = IMEM2.mem LOC = X1Y2;
            CPU/bram_imem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[1].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [17:9]  OUTPUT = IMEM1.mem LOC = X1Y3;
            CPU/bram_imem/BU2/U0/blk_mem_generator/valid.cstr/ramloop[0].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [8:0]   OUTPUT = IMEM0.mem LOC = X1Y1;
        END_BUS_BLOCK;
    END_ADDRESS_RANGE;
    END_ADDRESS_SPACE;

END_ADDRESS_MAP;

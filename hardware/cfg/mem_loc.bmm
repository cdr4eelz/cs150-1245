//  The _xmsgs/xst.xmsgs created by coregen seems a viable place to get the tail of these paths
//    (besides examiniation with data2mem or fpga_editor or planAhead).

// RAMB36 is blockram with parity (32-bits data + 4-bits parity, one-per-byte)
// In each BRAM, each lane is 4K (5120 w/parity) for total 16K (20480 w/parity)

// Note the difference in paths between the lanes (also different for CoreGen versions):
// CPU/brom_bios                vs. CPU/bram_dmem           vs. CPU/bram_imem
// TRUE_DP.SINGLE_PRIM36.TDP    vs. SP.SINGLE_PRIM36.SP     vs. SDP.SINGLE_PRIM36.TDP

ADDRESS_MAP MIPSY PPC405 0

// BIOS ROM:
    ADDRESS_SPACE BROM_BIOS RAMB36 WORD_ADDRESSING [0x40000000:0x40003FFF]
        BUS_BLOCK
            CPU/brom_bios/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[3].ram.r/v5_init.ram/TRUE_DP.SINGLE_PRIM36.TDP [35:27] OUTPUT = BMEM3.mem  LOC = X3Y25;
            CPU/brom_bios/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[2].ram.r/v5_init.ram/TRUE_DP.SINGLE_PRIM36.TDP [26:18] OUTPUT = BMEM2.mem  LOC = X2Y24;
            CPU/brom_bios/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[1].ram.r/v5_init.ram/TRUE_DP.SINGLE_PRIM36.TDP [17:9]  OUTPUT = BMEM1.mem  LOC = X2Y22;
            CPU/brom_bios/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[0].ram.r/v5_init.ram/TRUE_DP.SINGLE_PRIM36.TDP  [8:0]  OUTPUT = BMEM0.mem  LOC = X2Y21;
        END_BUS_BLOCK;
    END_ADDRESS_SPACE;

//OPTIONAL FAKE CONSOLIDATED MEMORY SPAN makes it easier to use the tools to punch it:
//  ADDRESS_SPACE BRAM_BOTH COMBINED WORD_ADDRESSING [0x00000000:0x00007FFF]
//  ADDRESS_RANGE RAMB36
    ADDRESS_SPACE BRAM_DMEM RAMB36 WORD_ADDRESSING [0x50000000:0x50003FFF]
        BUS_BLOCK
            CPU/bram_dmem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[3].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [35:27] OUTPUT = DMEM3.mem  LOC = X2Y27;
            CPU/bram_dmem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[2].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [26:18] OUTPUT = DMEM2.mem  LOC = X2Y26;
            CPU/bram_dmem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[1].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP [17:9]  OUTPUT = DMEM1.mem  LOC = X2Y28;
            CPU/bram_dmem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[0].ram.r/v5_init.ram/SP.SINGLE_PRIM36.SP  [8:0]  OUTPUT = DMEM0.mem  LOC = X3Y26;
        END_BUS_BLOCK;
    END_ADDRESS_SPACE;
//  END_ADDRESS_RANGE;

//  ADDRESS_RANGE RAMB36
    ADDRESS_SPACE BRAM_IMEM RAMB36 WORD_ADDRESSING [0x60000000:0x60003FFF]
        BUS_BLOCK
            CPU/bram_imem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[3].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [35:27] OUTPUT = IMEM3.mem  LOC = X2Y25;
            CPU/bram_imem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[2].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [26:18] OUTPUT = IMEM2.mem  LOC = X2Y19;
            CPU/bram_imem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[1].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [17:9]  OUTPUT = IMEM1.mem  LOC = X3Y24;
            CPU/bram_imem/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[0].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP  [8:0]  OUTPUT = IMEM0.mem  LOC = X3Y22;
        END_BUS_BLOCK;
    END_ADDRESS_SPACE;
//  END_ADDRESS_RANGE;
//  END_ADDRESS_SPACE;

// ISR RAM:
    ADDRESS_SPACE BRAM_ISR RAMB36 WORD_ADDRESSING [0xC0000000:0xC0003FFF]
        BUS_BLOCK
            CPU/bram_isr/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[3].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [35:27] OUTPUT = ISRM3.mem  LOC = X2Y23;
            CPU/bram_isr/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[2].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [26:18] OUTPUT = ISRM2.mem  LOC = X2Y20;
            CPU/bram_isr/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[1].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP [17:9]  OUTPUT = ISRM1.mem  LOC = X3Y23;
            CPU/bram_isr/U0/xst_blk_mem_generator/gnativebmg.native_blk_mem_gen/valid.cstr/ramloop[0].ram.r/v5_init.ram/SDP.SINGLE_PRIM36.TDP  [8:0]  OUTPUT = ISRM0.mem  LOC = X3Y21;
        END_BUS_BLOCK;
    END_ADDRESS_SPACE;

END_ADDRESS_MAP;

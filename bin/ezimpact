#!/bin/bash

if [ -z "$1" ]
then
    echo "usage: $0 <bitfile>"
    exit 1
fi


TMP_BATCH="_impact_$$"

echo "BIT:$1"
echo "BATCH:$TMP_BATCH"

tee $TMP_BATCH <<EOF
setMode -bscan
setCable -port auto
identify
assignFile -p 5 -file $1
program -p 5
quit
EOF

echo "----------"

impact -batch $TMP_BATCH && rm -f $TMP_BATCH


#!/usr/bin/python2

import sys, struct

if len(sys.argv) >= 2:
    name = sys.argv[1]
else:
    name = 'bin2rom'

if len(sys.argv) >= 3:
    offset = int(sys.argv[2], 16)
else:
    offset = 0

data = sys.stdin.read()

print 'module %s(input clk, input rst, input [29:0] addr, output reg [31:0] inst);' % name

print 'reg [29:0] addr_r;'

print 'always @(posedge clk)'
print 'begin'

print 'addr_r <= (rst) ? (30\'b0) : (addr);'

print 'end'

print 'always @(*)'
print 'begin'

print 'case(addr_r)'

for i in xrange(0, len(data), 4):
    print "30'h%08x: inst = 32'h%08x;" % ((i+offset)/4, struct.unpack('>L', data[i:i+4])[0])

print "default:      inst = 32'h00000000;"

print 'endcase'

print 'end'

print 'endmodule'

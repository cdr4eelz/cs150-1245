#!/bin/bash -eu

ACTION="${A:-f}"

LOG="._mq0.log"
LOGP="._mq1.log"
COLORIT=`which "colorit" 2>/dev/null || echo "cat"`
RM=`which /bin/rm 2>/dev/null || which rm 2>/dev/null || echo "rm"`
MV=`which /bin/mv 2>/dev/null || which mv 2>/dev/null || echo "mv"`

echo "LOG:${LOG}  COLORIT:${COLORIT}"
pwd
if [ "${ACTION}" == "v" ]; then
  cat "${LOGP}" |${COLORIT} |less
  exit 0
elif [ "${ACTION}" == "c" ]; then
  make clean
elif [ "${ACTION}" == "f" ]; then
  make clean
  ${RM} -rf "${LOGP}"
  [ -e "${LOG}" ] && ${MV} "${LOG}" "${LOGP}"
  ${RM} -rf "${LOG}"
  reset
  echo "LOG:${LOG}  COLORIT:${COLORIT}"
  make "$@" 2>&1 |tee "${LOG}" |${COLORIT}
else
  echo "Unrecognized???" >2
fi

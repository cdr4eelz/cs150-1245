#!/bin/bash

echo "Generating IP..."
ls *.xco

rm -rf tmp
mkdir tmp
cat > tmp/_batch <<EOM
NEWPROJECT .
SETPROJECT .
EOM

coregen -intstyle silent -b tmp/_batch
coregen -intstyle silent -p . -b *.xco
if [ "$?" -ne 0 ]; then
  echo "Error indicated.  All working files left alone."
  exit 1
fi

echo "Removing extras, owner-only permissions, dos2unix (if Cygwin)..."
rm -rf coregen.* *.txt *.pdf tmp/ xlnx_auto_0_xdb/ _xmsgs/
#rm -rf *.gise *.xise *.tcl *.asy
chmod -R u=rw,go= ./*/*
chmod u=rw,go= ./*
chmod -R u=rwX ./*
if [ $(uname -o) == "Cygwin" ]; then
  find . -type f -a -not -name '*.ngc' |xargs dos2unix --keepdate
fi

echo ""
ls -alR
echo ""


echo "To make a stash just make bzip2 tarball:"
echo "tar cvfj stash_xyz.tar.bz2 ..."


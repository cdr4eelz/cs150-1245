#!/bin/bash

echo "Generating IP:"
ls *.xco

rm -rf tmp
mkdir tmp
cat > tmp/_batch <<EOM
NEWPROJECT .
SETPROJECT .
EOM

coregen -intstyle silent -b tmp/_batch
coregen -intstyle silent -p . -b *.xco

echo "Removing unneeded project/temp files."
rm -rf coregen.* *.txt *.pdf tmp/ xlnx_auto_0_xdb/ 
#rm -rf coregen.* *.gise *.xise *.txt *.pdf tmp/ xlnx_auto_0_xdb/ 
chmod u=rw,go= *

echo ""
ls -al
echo ""


echo "To make a stash just make bzip2 tarball:"
echo "tar cvfj stash_xyz.tar.bz2 ..."


#!/usr/bin/python2

import sys

if len(sys.argv) != 4:
    print 'usage: %s <module-name> <bytes-wide> <addr-width>' % sys.argv[0]
    sys.exit(1)

module_name = sys.argv[1]

byte_count = int(sys.argv[2])
addr_width = int(sys.argv[3])

bit_width = byte_count*8
depth = 2**addr_width

print 'module %s' % module_name
print '('
print '    input         clka,'
print '    input         ena,'
print '    input  [%d:0] wea,'   % (byte_count-1)
print '    input  [%d:0] addra,' % (addr_width-1)
print '    input  [%d:0] dina,'  % (bit_width-1)
print '    output [%d:0] douta'  % (bit_width-1)
print ');\n'

print '\nreg [%d:0] addra_r;\n' % (addr_width-1)

for i in xrange(byte_count):
    print 'reg [%d:0] byte%d[%d:0];' % (7, i, depth)
    print 'initial'
    print 'begin'
    for j in xrange(depth):
        print 'byte%d[%d] = 8\'b0;' % (i, j)
    print 'end'
    print 'assign douta[%d:%d] = byte%d[addra_r];' % ((i+1)*8-1, i*8, i)

print '\nalways @(posedge clka)'
print 'begin\n'

print 'if (ena)'
print 'begin'
print 'addra_r <= addra;'
print 'end'

for i in xrange(byte_count):
    print 'if (ena && wea[%d])' % i
    print 'begin'
    print 'byte%d[addra] <= dina[%d:%d];' % (i, (i+1)*8-1, i*8)
    print 'end'

print '\nend\n'

for j in xrange(depth):
    print 'wire [%d:0] data%d;' % (bit_width-1, j)
    print 'assign data%d = {' % j,
    for i in xrange(byte_count-1, 0, -1):
        sys.stdout.write('byte%d[%d], ' % (i, j))
    print 'byte0[%d]};' % j

print 'always @(posedge clka)'
print 'begin'
print '$display("%s");' % module_name
print '$display("ena=%b wea=%b addra=%x", ena, wea, addra);'
print '$display("dina =%x", dina);'
print '$display("douta=%x", douta);'
for j in xrange(depth):
    print '$display("%x:%%x", data%d);' % (j, j)

print 'end'

print 'endmodule'

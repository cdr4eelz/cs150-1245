LDSTYLE ?= inject_basic
LDSRC ?= ../link/$(LDSTYLE).ld
START ?= ../link/$(LDSTYLE).s

# From software/bench: make -C ../gios; make FIXED_ELF=../gios/gios.elf
# The referenced image must remain loaded at the addresses in its ELF.
FIXED_ELF ?=
ifneq ($(strip $(FIXED_ELF)),)
FIXED_CCOPTS := -mlong-calls
FIXED_LDOPTS := -Wl,--just-symbols=$(FIXED_ELF)
endif

COMCS ?=
NOPCS ?=
ALLCS ?= $(wildcard *.c) $(COMCS:%=../common/%)
NOPTS ?= $(wildcard *.nopt.c) $(NOPCS:%=../common/%)
CSRCS ?= $(filter-out $(NOPTS),$(ALLCS))
SSRCS ?= $(wildcard *.s) $(START)

OUTS ?= mif coe mem # "dump v"
SECS ?= inst data

OBJS = $(SOBJS) $(COBJS)
SOBJS = $(SSRCS:%.s=%.s.o)
#COBJS = $(CSRCS:%.c=%.c.ll.s.o)
#COBJS = $(CSRCS:%.c=%.c.ll.o)
COBJS = $(CSRCS:%.c=%.c.o)
NOPTOBJS = $(NOPTS:%.c=%.c.o)

default: all
elf: $(TARGET).elf
dump: $(TARGET).dump $(TARGET).inst.dump $(TARGET).data.dump
syms: $(TARGET).syms
data: $(OUTS:%=$(TARGET).data.%)
inst: $(OUTS:%=$(TARGET).inst.%)
bins: $(SECS:%=$(TARGET).%.bin)


RM ?= `which "/bin/rm" 2>/dev/null || echo "rm"`
CLANG  ?= clang
LLC    ?= llc

M_ARCH ?= mips
M_TRI  ?= $(M_ARCH)-unknown-elf #The compiler is actually mips-linux-gnu
M_DIR  ?=
#M_PRE  ?= $(M_DIR)$(M_ARCH)-
#M_PRE  ?= mips-linux-gnu-
M_PRE  ?= mips64-linux-gnu

PGCC   ?= $(M_PRE)-gcc
PGAS   ?= $(M_PRE)-as
PSTRIP ?= $(M_PRE)-strip
PSIZE  ?= $(M_PRE)-size
PDUMP  ?= $(M_PRE)-objdump
PCOPY  ?= $(M_PRE)-objcopy
PNM    ?= $(M_PRE)-nm

ASOPTS ?= -mips1 -march=mips1 -mabi=32 --no-break --no-trap  -mno-pdr -non_shared -mno-shared -R -g2
# -O0
NO_CODE_REMOVAL ?=
CCOPTS ?= -pipe -fasm -std=gnu99 -ffreestanding -g
CCOPTS += -I../common
ifeq ($(strip $(NO_CODE_REMOVAL)),)
CCOPTS += -ffunction-sections -fdata-sections -Wl,--gc-sections
endif
#CCOPTS += -flto
OPTOPT ?= -Os
NOPOPT ?= -O0
CCMIPS ?= -mips1 -march=mips1 -mabi=32 -mno-abicalls -msoft-float -mno-dsp -mno-mips3d -mlong32 -mno-branch-likely -mno-flush-func -fno-PIE -fno-PIC -fno-pie -fno-pic -fno-exceptions -Wa,-mno-pdr,-non_shared,-mno-shared,-O,-R
# -G0
# -Wl,--strip-debug


# -pedantic
PCLANG ?= $(CLANG) -cc1 -triple=$(M_TRI) -target-cpu mips1 -target-abi o32 -mrelocation-model static
LIBOPTS ?= -nostartfiles -nostdlib -nodefaultlibs -static  -Wl,--build-id=none
PLLC   ?= $(LLC) -march=$(M_ARCH) -relocation-model=static


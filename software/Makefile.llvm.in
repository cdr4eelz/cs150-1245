LDSRC ?= ../datainst.ld
OUTS ?= mif coe mem v
SECS ?= data inst
PSRCS ?= $(wildcard *.p)
CSRCS ?= $(wildcard *.c)
SSRCS ?= $(wildcard *.s)
OBJS ?= $(POBJS) $(COBJS) $(SOBJS)

POBJS = $(PSRCS:%.p=%.p.llvm.s.o)
COBJS = $(CSRCS:%.c=%.c.llvm.s.o)
SOBJS = $(SSRCS:%.s=%.s.o)

all: both $(SECS)
data: $(OUTS:%=$(TARGET).data.%)
inst: $(OUTS:%=$(TARGET).inst.%)
both: $(TARGET).both.mem

bins: $(SECS:%=$(TARGET).%.bin) #$(TARGET).both.bin

$(TARGET).elf: $(OBJS)
	mips-gcc -static -nostartfiles -nostdlib -nodefaultlibs -G0 -T $(LDSRC) $^ -o $@
	chmod -x $@

%.data.bin: %.elf
	mips-objcopy -j .data -p -O binary $^ $@
	chmod -x $@

%.inst.bin: %.elf
	mips-objcopy -j .text -p -O binary $^ $@
	chmod -x $@

#%.both.bin: %.data.bin %.inst.bin
#	truncate -s 16K $@
#	cat $^ > $@

%.mif: %.bin
	bin2mif < $^ > $@

%.coe: %.bin
	bin2coe < $^ > $@

%.mem: %.bin
	bin2mem 0 < $^ > $@

%.both.mem: %.data.bin %.inst.bin
	bin2mem     0 < $*.data.bin > $@
	bin2mem 16384 < $*.inst.bin | sed s/^@00000000/@00004000/ >> $@

%.v: %.bin
	bin2rom < $^ > $@

%.c.llvm: %.c
	clang -static -emit-llvm -S -o $<.llvm $<

%.c.llvm.s: %.c.llvm
	llc -relocation-model=static -march=mips -o $<.s $<

%.s.o: %.s
	mips-as $< -o $<.o

clean:
	rm -f $(POBJS) $(COBJS) $(SOBJS) $(TARGET).elf $(TARGET).*.bin $(TARGET).*.mif $(TARGET).*.coe $(TARGET).*.mem $(TARGET).*.v

.PHONY: clean


CSRCS := $(wildcard *.c)
COBJS := $(CSRCS:%.c=%.c.llvm.s.o)

SSRCS := $(wildcard *.s)
SOBJS := $(SSRCS:%.s=%.s.o)

LDSRC := $(TARGET).ld

all: inst data

inst: $(TARGET)_INST.mif $(TARGET)_INST.coe $(TARGET)_INST.mem $(TARGET)_INST.v

data: $(TARGET)_DATA.mif $(TARGET)_DATA.coe $(TARGET)_DATA.mem $(TARGET)_DATA.v

$(TARGET).elf: $(COBJS) $(SOBJS)
	mips-gcc -static -nostartfiles -nostdlib -nodefaultlibs -G0 -T $(LDSRC) $^ -o $@
	chmod -x $@

%_INST.bin: %.elf
	mips-objcopy -j .text -p -O binary $^ $@
	chmod -x $@

%_DATA.bin: %.elf
	mips-objcopy -j .data -p -O binary $^ $@
	chmod -x $@

%.mif: %.bin
	bin2mif < $^ > $@

%.coe: %.bin
	bin2coe < $^ > $@

%.mem: %.bin
	bin2mem < $^ > $@

%.v: %.bin
	bin2rom < $^ > $@

%.c.llvm: %.c
	clang -static -emit-llvm -S -o $<.llvm $<

%.c.llvm.s: %.c.llvm
	llc -relocation-model=static -march=mips -o $<.s $<

%.s.o: %.s
	mips-as $< -o $<.o

clean:
	rm -f $(COBJS) $(SOBJS) $(TARGET).elf $(TARGET)_*.bin $(TARGET)_*.mif $(TARGET)_*.coe $(TARGET)_*.mem $(TARGET)_*.v

.PHONY: all inst data clean


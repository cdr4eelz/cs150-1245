LDSTYLE ?= inject_basic
LDSRC ?= ../link/$(LDSTYLE).ld
START ?= ../link/$(LDSTYLE).s
LIBOPTS ?= -nostartfiles -nostdlib -nodefaultlibs

OUTS ?= mif coe # "mem dump v"
SECS ?= data inst
PSRCS ?= $(wildcard *.p)
CSRCS ?= $(wildcard *.c)
SSRCS ?= $(wildcard *.s) $(START)

OBJS = $(POBJS) $(COBJS) $(SOBJS)
SOBJS = $(SSRCS:%.s=%.s.o)
POBJS = $(PSRCS:%.p=%.p.llvm.s.o)
COBJS = $(CSRCS:%.c=%.c.llvm.s.o)
#COBJS = $(CSRCS:%.c=%.c.o)


all: elf dump $(SECS)
elf: $(TARGET).elf
dump: $(TARGET).dump

data: $(OUTS:%=$(TARGET).data.%)
inst: $(OUTS:%=$(TARGET).inst.%)
#both: $(OUTS:%=$(TARGET).both.%)
#both: $(TARGET).both.mem
bins: $(SECS:%=$(TARGET).%.bin)

.PRECIOUS: %.s %.c.llvm.s


$(TARGET).elf: $(OBJS)
	mips-gcc -static $(LIBOPTS) -T $(LDSRC) $^ -o $@ -G 0 -mno-gpopt
#	mips-strip -R .pdr -R .comment -R .reginfo $@
	chmod -x $@

%.data.bin: %.elf
	mips-objcopy -j .data -p -O binary $^ $@
	chmod -x $@

%.inst.bin: %.elf
	mips-objcopy -j .text -p -O binary $^ $@
	chmod -x $@

%.dump: %.elf
	mips-objdump $^ -xsD >$@
%.inst.dump: %.elf
	mips-objdump -j .text $^ -xsD >$@
%.data.dump: %.elf
	mips-objdump -j .data $^ -xS >$@

%.mif: %.bin
	bin2mif < $^ > $@

%.coe: %.bin
	bin2coe < $^ > $@

%.mem: %.bin
	bin2mem 0 < $^ > $@

%.v: %.bin
	bin2rom < $^ > $@


%.c.o: %.c
	mips-gcc -std=gnu99 -c $< -o $@

%.c.llvm.s: %.c
	clang -cc1 -triple mips-unknown-elf -mrelocation-model static -S -o $@ $<

%.s.o: %.s
	mips-as $< -o $<.o

clean:
	rm -f *.o *.llvm *.elf *.bin *.mif *.coe *.mem *.v *.dump *.llvm.s

.PHONY: clean

